DATABASE_URL=
CRON_SECRET=
APP_URL=

# OneSignal (transactional email)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Firebase Admin (server-side token verification)
# locally these are read at build time via nuxt.config.ts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# on vercel set these NUXT_ prefixed versions instead
# nuxt reads them fresh on every request, no rebuild needed after a change
NUXT_FIREBASE_ADMIN_PROJECT_ID=
NUXT_FIREBASE_ADMIN_CLIENT_EMAIL=
NUXT_FIREBASE_ADMIN_PRIVATE_KEY=

# Firebase client config (safe to expose in the browser)
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NUXT_SESSION_PASSWORD=
